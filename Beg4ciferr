local function posOf(obj)
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	return obj.Position
end

-- how tall the coin is (so we know how little of us has to poke into it)
local function halfHeight(obj)
	if obj:IsA("Model") then
		return obj:GetExtentsSize().Y / 2
	end
	local s, cf = obj.Size, obj.CFrame
	return (math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z) / 2
end

local function isIgnored(obj)
	local t = ignored[obj]
	return t ~= nil and t > os.clock()
end

local function countLeft()
	local n = 0
	for c in pairs(coins) do
		if c.Parent and not isIgnored(c) then
			n += 1
		end
	end
	return n
end

local leftLabel -- created with the farm page below
local function setLeft()
	if leftLabel then
		leftLabel.Text = "coins left  " .. countLeft()
	end
end

local function nearest(pos)
	local best, bestD
	for c in pairs(coins) do
		if c.Parent and not isIgnored(c) then
			local d = (posOf(c) - pos).Magnitude
			if not bestD or d < bestD then
				best, bestD = c, d
			end
		end
	end
	return best
end

local function grabbed(obj)
	ignored[obj] = os.clock() + IGNORE_TIME
	setLeft()
end

local function dropTarget()
	target, dwellUntil, rising = nil, nil, false
end

local function goalFor(obj, pos)
	local c = posOf(obj)
	if not underOn then
		return c + ABOVE
	end
	deepY = c.Y - DEPTH
	surfY = c.Y
	local flat = Vector3.new(c.X - pos.X, 0, c.Z - pos.Z).Magnitude
	-- once we start rising we stay rising, otherwise it flips back and forth near the coin
	if rising then
		if flat > NEAR * 2.5 then rising = false end
	elseif flat <= NEAR then
		rising = true
	end
	if not rising then
		return Vector3.new(c.X, deepY, c.Z)
	end
	return Vector3.new(c.X, c.Y - halfHeight(obj) - BODY_HALF + OVERLAP, c.Z)
end

-- eased movement: accelerates, cruises at the slider speed, brakes into the goal
local function steer(pos, goal, dt)
	local diff = goal - pos
	local dist = diff.Magnitude
	if dist < 0.001 then return pos end
	local want = math.min(speed, math.max(dist * EASE, SLOW))
	vel = vel:Lerp(diff.Unit * want, 1 - math.exp(-ACCEL * dt))
	local step = vel * dt
	if step.Magnitude >= dist then
		vel = Vector3.zero
		return goal
	end
	return pos + step
end

local function surface()
	if not wentUnder then return end
	wentUnder = false
	wasLay = false
	deepY, surfY = nil, nil
	local r = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if r then
		r.CFrame = CFrame.new(r.Position + Vector3.new(0, DEPTH + 4, 0)) * CFrame.Angles(0, yaw, 0)
		r.AssemblyLinearVelocity = Vector3.zero
	end
end

