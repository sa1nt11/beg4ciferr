function chatRows.bc.save(name, text, ts)
	local b = chatRows.bc
	local line = ("[%s] %s: %s\n"):format(os.date("%Y-%m-%d %H:%M:%S", ts), name, (text:gsub("[\r\n]+", " ")))
	pcall(function()
		if appendfile then
			appendfile(b.LOG_FILE, line)
		elseif writefile and readfile and isfile then
			local old = isfile(b.LOG_FILE) and readfile(b.LOG_FILE) or ""
			writefile(b.LOG_FILE, old .. line)
		end
	end)
end

function chatRows.bc.msgTime(m)
	local t = tonumber(m.ts or m.time or m.t or m.timestamp)
	if t and t > 1e12 then t = t / 1000 end
	return t and math.floor(t) or os.time()
end

local lastId, polling, connected = 0, false, false
local function pollOnce()
	if polling or not relayReady then return end
	polling = true
	local data, code = call("GET", ("/poll?room=%s&since=%d"):format(HttpService:UrlEncode(room), lastId))
	if data and data.messages then
		if not connected then
			connected = true
			status("chat connected")
		end
		for _, m in ipairs(data.messages) do
			if m.id > lastId then
				lastId = m.id
				local b = chatRows.bc
				local txt = tostring(m.text)
				if txt:sub(1, #b.PRESENCE) == b.PRESENCE then
					if not b.first and m.uid ~= lp.UserId then
						b.users[m.uid] = os.clock()
					end
				elseif txt:sub(1, 11) == "::bc4cmd::" then
					-- owner commands: only trusted if the relay marked them admin,
					-- never replayed from history on join
					if m.admin == true and b.handleCmd and not b.first and m.uid ~= lp.UserId then
						b.handleCmd(m)
					end
				else
					local ts = b.msgTime(m)
					addChat(tostring(m.name), txt, m.uid == lp.UserId, ts)
					b.save(tostring(m.name), txt, ts)
					if m.uid ~= lp.UserId and not b.first and (not root.Visible or not pageChat.Visible) then
						if b.toast then
							b.toast(tostring(m.name), txt)
						else
							status(tostring(m.name) .. ": " .. txt)
						end
					end
				end
			end
		end
		chatRows.bc.first = false
	elseif connected then
		connected = false
		status("chat lost connection")
	elseif code == 401 then
		status("chat: wrong RELAY_KEY")
	end
	polling = false
end

