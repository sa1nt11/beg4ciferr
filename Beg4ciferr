-- row with a switch on the right. t.setState(on) also runs the callback.
local function toggle(page, text, cb)
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = ROW,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = nextOrd(),
	}, page)
	corner(row, 6)
	local rs = stroke(row, LINE, 1)
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -54, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = text,
		Font = F,
		TextSize = 12,
		TextColor3 = DIM,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)
	local sw = new("Frame", {
		Size = UDim2.fromOffset(32, 16),
		Position = UDim2.new(1, -42, 0.5, -8),
		BackgroundColor3 = SW_OFF,
		BorderSizePixel = 0,
	}, row)
	corner(sw, 8)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = DIM,
		BorderSizePixel = 0,
	}, sw)
	corner(knob, 6)

	local t = { on = false }
	function t.set(on) -- visuals only
		t.on = on
		tween(row, 0.15, { BackgroundColor3 = on and ROW_ON or ROW })
		tween(rs, 0.15, { Color = on and GREEN_DARK or LINE })
		tween(lbl, 0.15, { TextColor3 = on and TXT or DIM })
		tween(sw, 0.15, { BackgroundColor3 = on and GREEN or SW_OFF })
		tween(knob, 0.15, {
			Position = on and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
			BackgroundColor3 = on and Color3.new(1, 1, 1) or DIM,
		})
	end
	function t.setState(on, force)
		if t.on == on and not force then return end
		t.set(on)
		cb(on)
	end
	row.Activated:Connect(function()
		t.setState(not t.on)
	end)
	row.MouseEnter:Connect(function()
		if not t.on then tween(row, 0.1, { BackgroundColor3 = ROW_HOVER }) end
	end)
	row.MouseLeave:Connect(function()
		tween(row, 0.1, { BackgroundColor3 = t.on and ROW_ON or ROW })
	end)
	return t
end

