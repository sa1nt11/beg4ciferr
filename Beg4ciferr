-- localscript, goes in StarterPlayerScripts
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

local NAME = "Coin_Server"
local MIN_SPEED, MAX_SPEED = 5, 100
local SPIN_DEG = 720
local IGNORE_TIME = 5          -- secs a grabbed coin gets skipped
local ABOVE = Vector3.new(0, 1, 0)
local DEPTH = 8                -- how far under the coin you travel
local TOUCH_Y = -1             -- height vs coin when grabbing it underground
