-- lighting: fullbright and spooky sky share one saved copy of the originals
local LIGHT_PROPS = { "Brightness", "ClockTime", "FogStart", "FogEnd", "FogColor", "Ambient", "OutdoorAmbient", "GlobalShadows" }
local lightSaved, grade
local function applyLight()
	if grade then
		grade:Destroy()
		grade = nil
	end
	if (brightOn or spookyOn) and not lightSaved then
		lightSaved = {}
		for _, k in ipairs(LIGHT_PROPS) do
			lightSaved[k] = Lighting[k]
		end
	end
	if brightOn then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 1e5
		Lighting.Ambient = Color3.fromRGB(200, 200, 200)
		Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
		Lighting.GlobalShadows = false
	elseif spookyOn then
		-- purple night + orange tint, still bright enough to see where you're going
		Lighting.Brightness = 1.5
		Lighting.ClockTime = 0
		Lighting.FogColor = Color3.fromRGB(38, 16, 52)
		Lighting.FogStart = 120
		Lighting.FogEnd = 900
		Lighting.Ambient = Color3.fromRGB(105, 70, 140)
		Lighting.OutdoorAmbient = Color3.fromRGB(95, 62, 130)
		grade = Instance.new("ColorCorrectionEffect")
		grade.Tint = Color3.fromRGB(255, 220, 190)
		grade.Saturation = 0.15
		grade.Contrast = 0.08
		grade.Parent = Lighting
	elseif lightSaved then
		for k, v in pairs(lightSaved) do
			Lighting[k] = v
		end
		lightSaved = nil
	end
end

