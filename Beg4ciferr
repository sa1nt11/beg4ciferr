local function esc(s)
	return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function addChat(name, text, mine, ts)
	chatCount += 1
	local when = ts and ('<font color="#8c9694">[%s]</font> '):format(os.date("%m/%d %H:%M:%S", ts)) or ""
	local l = new("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -4, 0, 0),
		BackgroundTransparency = 1,
		RichText = true,
		TextWrapped = true,
		Font = F,
		TextSize = 12,
		TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = chatCount,
		Text = ('%s<font color="%s">%s</font>  %s'):format(when, mine and "#39ff6a" or "#ff8a20", esc(name), esc(text)),
	}, chatLog)
	chatRows[#chatRows + 1] = l
	if #chatRows > 60 then
		table.remove(chatRows, 1):Destroy()
	end
	task.delay(0.05, function()
		chatLog.CanvasPosition = Vector2.new(0, math.max(0, chatLog.AbsoluteCanvasSize.Y - chatLog.AbsoluteSize.Y))
	end)
end

-- one request to the relay. returns the decoded reply, or nil + status code
local function call(method, path, body)
	if not httpReq then return nil end
	local ok, res = pcall(httpReq, {
		Url = RELAY_URL .. path,
		Method = method,
		Headers = { ["Content-Type"] = "application/json", ["x-key"] = RELAY_KEY },
		Body = body and HttpService:JSONEncode(body) or nil,
	})
	if not ok or type(res) ~= "table" then return nil end
	if res.StatusCode ~= 200 then return nil, res.StatusCode end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	return ok2 and data or nil
end

local relayReady = true
if not httpReq then
	relayReady = false
	addChat("info", "your executor has no http request function, so chat is off.", false)
elseif RELAY_URL:find("your%-relay") then
	relayReady = false
	addChat("info", "set RELAY_URL and RELAY_KEY at the top of the chat section.", false)
else
	addChat("info", "private chat. only people running this script in the same room see it. messages are saved with date + time to beg4ciferr_chat_log.txt. the owner can freeze or bring users who abuse the script.", false)
end

