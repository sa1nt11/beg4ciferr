local function refreshSlider()
	local a = (speed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
	fill.Size = UDim2.new(a, 0, 1, 0)
	knob.Position = UDim2.new(a, 0, 0.5, 0)
	speedLabel.Text = ("speed: %d studs/s"):format(speed)
end

local function setFromX(x)
	local a = math.clamp((x - area.AbsolutePosition.X) / area.AbsoluteSize.X, 0, 1)
	speed = math.floor(MIN_SPEED + a * (MAX_SPEED - MIN_SPEED) + 0.5)
	refreshSlider()
end
refreshSlider()

-- input (slider + dragging the window by its title)
local sliding, moving = false, false
local dragStart, startPos

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

area.InputBegan:Connect(function(i)
	if isPress(i) then
		sliding = true
		setFromX(i.Position.X)
	end
end)

title.InputBegan:Connect(function(i)
	if isPress(i) then
		moving = true
		dragStart = i.Position
		startPos = frame.Position
	end
end)

UIS.InputChanged:Connect(function(i)
	if not isMove(i) then return end
	if sliding then
		setFromX(i.Position.X)
	elseif moving then
		local d = i.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)

UIS.InputEnded:Connect(function(i)
	if isPress(i) then
		sliding = false
		moving = false
	end
end)

-- coins
local function posOf(obj)
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	return obj.Position
end

local function isIgnored(obj)
	local t = ignored[obj]
	return t ~= nil and t > os.clock()
end

local function countLeft()
	local n = 0
	for _, c in ipairs(coins) do
		if c.Parent and not isIgnored(c) then
			n += 1
		end
	end
	return n
end

local function scan()
	local list = {}
	for _, o in ipairs(workspace:GetDescendants()) do
		if o.Name == NAME and (o:IsA("BasePart") or o:IsA("Model")) then
			table.insert(list, o)
		end
	end
	coins = list
end

local function nearest(pos)
	local best, bestD
	for _, c in ipairs(coins) do
		if c.Parent and not isIgnored(c) then
			local d = (posOf(c) - pos).Magnitude
			if not bestD or d < bestD then
				best, bestD = c, d
			end
		end
	end
	return best
end

local function grabbed(obj)
	ignored[obj] = os.clock() + IGNORE_TIME
	leftLabel.Text = "left: " .. countLeft()
end

local function goalFor(coinPos, pos)
	if not underOn then
		return coinPos + ABOVE
	end
	local flat = Vector3.new(coinPos.X - pos.X, 0, coinPos.Z - pos.Z).Magnitude
	if flat > NEAR then
		return Vector3.new(coinPos.X, coinPos.Y - DEPTH, coinPos.Z)
	end
	return coinPos + Vector3.new(0, TOUCH_Y, 0)
end

local function surface()
	if not wentUnder then return end
	wentUnder = false
	wasLay = false
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(root.Position + Vector3.new(0, DEPTH + 4, 0)) * CFrame.Angles(0, yaw, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

task.spawn(function()
	while true do
		scan()
		leftLabel.Text = "left: " .. countLeft()
		task.wait(0.5)
	end
end)

-- noclip while under so the floor doesn't shove you out
RunService.Stepped:Connect(function()
	if not (tpOn and underOn) then return end
	local char = lp.Character
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
end)

-- main loop: move + spin + lay down in one place so they don't fight
RunService.Heartbeat:Connect(function(dt)
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not (tpOn or spinOn) or not root then
		wasLay = false
		return
	end

	local pos = root.Position
	local lay = tpOn and underOn

	if spinOn then
		yaw += math.rad(SPIN_DEG) * dt
	elseif not wasLay then
		local _, y = root.CFrame:ToOrientation()
		yaw = y
	end
	wasLay = lay

	if tpOn then
		if target then
			if not target.Parent then
				if targetGoal and (pos - targetGoal).Magnitude < 8 then
					grabbed(target)
				end
				target = nil
			elseif isIgnored(target) then
				target = nil
			end
		end

		if not target then
			target = nearest(pos)
		end

		if target then
			local goal = goalFor(posOf(target), pos)
			targetGoal = goal
			local diff = goal - pos
			local step = speed * dt
			if diff.Magnitude <= math.max(step, 1) then
				pos = goal
				grabbed(target)
				target = nil
			else
				pos = pos + diff.Unit * step
			end
		end

		root.AssemblyLinearVelocity = Vector3.zero
		if underOn then
			wentUnder = true
		end
	end

	local rot = CFrame.Angles(0, yaw, 0)
	if lay then
		rot = rot * CFrame.Angles(math.rad(90), 0, 0) -- on your back, face up
	end
	root.CFrame = CFrame.new(pos) * rot
end)

-- buttons
tpBtn.Activated:Connect(function()
	tpOn = not tpOn
	target = nil
	setOn(tpBtn, tpOn)
	if not tpOn then surface() end
end)

spinBtn.Activated:Connect(function()
	spinOn = not spinOn
	setOn(spinBtn, spinOn)
end)

underBtn.Activated:Connect(function()
	underOn = not underOn
	setOn(underBtn, underOn)
	if not underOn then surface() end
end)
