		Position = UDim2.fromOffset(10, 4),
		BackgroundTransparency = 1,
		Text = text,
		Font = F,
		TextSize = 12,
		TextColor3 = DIM,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		Size = UDim2.new(0.4, -10, 0, 16),
		Position = UDim2.new(0.6, 0, 0, 4),
		BackgroundTransparency = 1,
		Font = F,
		TextSize = 12,
		TextColor3 = GREEN,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	local area = new("Frame", {
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 20),
		BackgroundTransparency = 1,
	}, row)
	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0.5, -2),
		BackgroundColor3 = Color3.fromRGB(34, 30, 44),
		BorderSizePixel = 0,
	}, area)
	corner(track, 2)
	local fill = new("Frame", { BackgroundColor3 = GREEN, BorderSizePixel = 0 }, track)
	corner(fill, 2)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = GREEN_LIGHT,
		BorderSizePixel = 0,
	}, area)
	corner(knob, 6)
	stroke(knob, GREEN, 2)

	local function refresh()
		local a = (s.value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
