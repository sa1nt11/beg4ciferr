-- main loop. runs before physics each frame so nothing fights the position we set
RunService.PreSimulation:Connect(function(dt)
	local char = lp.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	if not r then
		wasLay = false
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")

	-- walkspeed / jump power / gravity overrides (games like to reset these, so every frame)
	if hum then
		if walkOn then hum.WalkSpeed = walkVal end
		if jumpOn then
			if hum.UseJumpPower then
				hum.JumpPower = jumpVal
			else
				hum.JumpHeight = 7.2 * (jumpVal / 50) ^ 2
			end
		end
	end
	if gravOn then workspace.Gravity = gravVal end

	-- anti void: remember the last solid ground, snap back if you fall off the map
	if voidOn and not (tpOn and underOn) then
		if r.Position.Y < workspace.FallenPartsDestroyHeight + 60 then
			if lastGround then
				r.CFrame = lastGround
				r.AssemblyLinearVelocity = Vector3.zero
			end
		elseif hum and hum.FloorMaterial ~= Enum.Material.Air then
			lastGround = r.CFrame + Vector3.new(0, 3, 0)
		end
	end

	-- anti fling: undo crazy velocity, and stop other players' bodies from colliding with you
	-- (paused while flying, fly speed would look like a fling)
	if flingOn and not flyOn then
		local v, w = r.AssemblyLinearVelocity, r.AssemblyAngularVelocity
		local flat = Vector3.new(v.X, 0, v.Z).Magnitude
		if flat > FLING_SPEED or v.Y > FLING_UP or w.Magnitude > FLING_SPIN then
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
			if safeCF then r.CFrame = safeCF end
		else
			safeCF = r.CFrame
		end
		for _, p in ipairs(otherParts) do
			if p.CanCollide then p.CanCollide = false end
		end
	end

	-- noclip (tp always noclips) + stop the humanoid from fighting us while tp is on
	if tpOn or noclipOn then
		for _, p in ipairs(myParts) do
			if p.CanCollide then p.CanCollide = false end
		end
	end
	if tpOn and hum and not hum.PlatformStand then
		hum.PlatformStand = true
	end

	-- fly: steer with the normal movement controls + where the camera looks
	if flyOn and not tpOn and hum then
		local cam = workspace.CurrentCamera
		if cam then
			local mv = moveVec(hum)
			local cf = cam.CFrame
			local dir = cf.RightVector * mv.X - cf.LookVector * mv.Z
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
			end
			local want = dir.Magnitude > 0.05 and dir.Unit * flyVal or Vector3.zero
			flyVel = flyVel:Lerp(want, 1 - math.exp(-10 * dt))
			hum.PlatformStand = true
			-- the extra upward bit cancels the gravity that gets added this frame
			r.AssemblyLinearVelocity = flyVel + Vector3.new(0, workspace.Gravity * dt, 0)
			r.AssemblyAngularVelocity = Vector3.zero
			local look = cf.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				r.CFrame = CFrame.lookAt(r.Position, r.Position + flat)
			end
		end
	end

	if not (tpOn or spinOn) then
		wasLay = false
		return
	end

	local pos = r.Position
	local lay = tpOn and underOn

	if spinOn then
		yaw += math.rad(SPIN_DEG) * dt
	elseif not wasLay then
		local _, y = r.CFrame:ToOrientation()
		yaw = y
	end
	wasLay = lay

	if tpOn then
		if target then
			if not target.Parent then
				if targetGoal and (pos - targetGoal).Magnitude < 8 then
					grabbed(target)
				end
				dropTarget()
			elseif isIgnored(target) then
				dropTarget()
			elseif os.clock() - targetAt > targetLimit then
				-- stuck on this one, skip it
				ignored[target] = os.clock() + IGNORE_TIME
				dropTarget()
			end
		end

		if not target then
			target = nearest(pos)
			if target then
				targetAt = os.clock()
				targetLimit = 4 + ((posOf(target) - pos).Magnitude / speed) * 2.5
			end
		end

		if target then
			local goal = goalFor(target, pos)
			targetGoal = goal

			if dwellUntil then
				-- sitting on the coin until the touch goes through
				pos = goal
				if os.clock() >= dwellUntil then
					grabbed(target)
					dropTarget()
				end
			elseif (goal - pos).Magnitude <= ARRIVE then
				pos = goal
				vel = Vector3.zero
				dwellUntil = os.clock() + DWELL
			else
				pos = steer(pos, goal, dt)
			end
		elseif underOn and deepY then
			-- nothing to grab: sink back down and wait
			pos = steer(pos, Vector3.new(pos.X, deepY, pos.Z), dt)
		else
			vel = Vector3.zero
		end

		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if underOn then
			wentUnder = true
		end
	else
		vel = Vector3.zero
	end

	local rot = CFrame.Angles(0, yaw, 0)
	if lay then
		rot = rot * CFrame.Angles(math.rad(90), 0, 0) -- on your back, face up
	end
	r.CFrame = CFrame.new(pos) * rot
end)
