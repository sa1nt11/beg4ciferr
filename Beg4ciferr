-- drag (window + pumpkin), kept on screen
local function clampPos(px, size)
	local vp = gui.AbsoluteSize
	return Vector2.new(
		math.clamp(px.X, 0, math.max(0, vp.X - size.X)),
		math.clamp(px.Y, 0, math.max(0, vp.Y - size.Y))
	)
end

local function makeDraggable(handle, targetGui, onTap)
	local down, moved, start, origin = false, false, nil, nil
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			down, moved, start = true, false, i.Position
			local p, vp = targetGui.Position, gui.AbsoluteSize
			origin = Vector2.new(p.X.Scale * vp.X + p.X.Offset, p.Y.Scale * vp.Y + p.Y.Offset)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if down and isMove(i) then
			local d = i.Position - start
			if not moved and d.Magnitude < 5 then return end
			moved = true
			local np = clampPos(origin + Vector2.new(d.X, d.Y), targetGui.AbsoluteSize)
			targetGui.Position = UDim2.fromOffset(np.X, np.Y)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if down and isPress(i) then
			down = false
			if not moved and onTap then onTap() end
		end
	end)
end

